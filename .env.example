# SiteNav — every environment variable the server reads.
# Copy to .env for local dev (gitignored); on Koyeb/Render/Oracle set these in
# the host's environment/secrets UI instead. Never commit real values.

# ── Site ──────────────────────────────────────────────────────────────────
SITE=landcros                       # which sites/<slug>/ this deployment serves
PORT=50000                          # host usually injects this (Koyeb: 8000)

# ── Sessions (required) ───────────────────────────────────────────────────
# Signs the login cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# ── Supabase (required: database, auth identities, hazard photo storage) ──
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SECRET_KEY=                # service_role key — SERVER ONLY, never ship to a browser
SUPABASE_DB_URL=                    # Postgres pooler connection string

# Comma-separated emails that bypass the domain check and are seeded as owner.
PLATFORM_ADMIN_EMAILS=

# ── Email (required for PIN login + hazard reports) ───────────────────────
# Set EITHER the SMTP group OR RESEND_API_KEY. SMTP wins if both are present.
# MAIL_TRANSPORT=smtp|resend        # optional, forces one explicitly

# Option A — SMTP through an ordinary mailbox. No DNS access needed, and mail
# genuinely comes from that address. Microsoft 365 usually needs SMTP AUTH
# enabled for the mailbox plus an app password.
SMTP_HOST=                          # smtp.office365.com | smtp.gmail.com | ...
SMTP_PORT=587                       # 587 STARTTLS, 465 implicit TLS
SMTP_USER=                          # the mailbox address to authenticate as
SMTP_PASS=                          # that mailbox's password or app password

# Option B — Resend HTTP API. Needs a domain verified in Resend (DNS records).
RESEND_API_KEY=

# Sender address. On SMTP this defaults to SMTP_USER and most providers REQUIRE
# From to match the authenticated mailbox — leave unset unless you have Send As.
# On Resend it must be on a verified domain.
# MAIL_FROM=SiteNav <noreply@example.com>

# Absolute origin used to build emailed links (share links, PIN reset).
# Falls back to the request Host header, which a spoofed header could poison.
PUBLIC_BASE_URL=https://your-app.koyeb.app

# ── Local dev only ────────────────────────────────────────────────────────
# With no mail transport configured, return the PIN link in the API response
# so you can click through without an email account. NEVER set in production:
# it hands the link to whoever typed the email address.
# ALLOW_INSECURE_PIN_LINKS=1

# Optional: auto-commit data changes back to GitHub (legacy path).
# GITHUB_PAT=
